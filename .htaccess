# Ralif Engenharia — Apache/cPanel
# A página inicial oficial é Index.html, servida com a camada de correção responsiva.
DirectoryIndex Index.html index.html index.htm

<IfModule mod_authz_core.c>
    Require all granted
</IfModule>
<IfModule mod_access_compat.c>
    Order allow,deny
    Allow from all
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    # Endpoint do formulário: /actions -> actions.php
    RewriteRule ^actions/?$ actions.php [END,QSA]
    # Home: preserva o cabeçalho/rodapé React oficial e injeta só as correções globais.
    RewriteRule ^$ serve-page.php?file=Index.html [END,QSA]
    RewriteRule ^index\.html$ serve-page.php?file=Index.html [NC,END,QSA]
    # Todas as páginas HTML secundárias recebem o mesmo menu e rodapé.
    RewriteRule ^(.+\.html)$ serve-page.php?file=$1 [END,QSA]
</IfModule>

<IfModule mod_mime.c>
    AddDefaultCharset UTF-8
    AddType image/webp .webp
    AddType image/svg+xml .svg
    AddType font/woff2 .woff2
</IfModule>
